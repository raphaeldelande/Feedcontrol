# Clé uniquement sur la machine qui lance Python. Ne jamais la mettre dans l'extension.
YOUTUBE_API_KEY=
# Optionnel : 1 pour réutiliser le moteur multilingue V3 (installation séparée).
FEEDCONTROL_SEMANTIC=0
# Analyse réelle des images publiques (Pillow/numpy). OCR si Tesseract est installé.
FEEDCONTROL_VISION=1
# Optionnel : nom d'un modèle visuel déjà installé dans Ollama sur 127.0.0.1:11434.
# Exemple : qwen2.5vl:3b (nécessite téléchargement séparé, mémoire et Ollama).
FEEDCONTROL_VISION_MODEL=
